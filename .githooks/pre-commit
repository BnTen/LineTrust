#!/usr/bin/env bash
# Block committing secret env files. Allows .env.example only.
# Enable with: git config core.hooksPath .githooks

set -euo pipefail

if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  staged="$(git diff --cached --name-only --diff-filter=ACM || true)"
  blocked="$(printf '%s\n' "$staged" | grep -E '(^|/)\.env' | grep -vE '\.env\.example$' || true)"
  if [ -n "$blocked" ]; then
    echo "pre-commit: refusing to commit secret env files:" >&2
    printf '%s\n' "$blocked" >&2
    echo "Keep secrets local; only .env.example may be committed." >&2
    exit 1
  fi
fi

exit 0
